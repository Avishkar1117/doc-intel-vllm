# docker/Dockerfile.api — app-tier container image only, no model weights or GPU deps.
# The FastAPI app never loads a model (PROJECT_BRIEF.md §4) - this image has no CUDA base,
# no vLLM, nothing from the [modal-serving] extra. That extra only ever gets installed
# inside modal_app.py's own image, on Modal's infrastructure.

# --- builder stage: resolve + install dependencies, then the project itself -----------
FROM python:3.12-slim AS builder

# uv pinned to match local dev exactly (checked via `uv --version`, not assumed) - avoids
# any lockfile-schema surprise between what wrote uv.lock and what reads it in CI/prod.
COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /uvx /bin/

# Cache mounts need copy-mode linking since the cache and /app can be on different
# filesystems inside the builder - hardlinking would fail silently otherwise.
ENV UV_LINK_MODE=copy
WORKDIR /app

# Dependencies first, project code second: this layer only invalidates when
# pyproject.toml/uv.lock change, not on every source edit - most rebuilds skip straight
# to the fast layer below. --no-install-project: nothing under src/ exists yet at this
# point, so there's nothing of the project itself to install.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-editable --no-dev

COPY pyproject.toml uv.lock ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable --no-dev

# --- final stage: just the venv + source, no uv, no build toolchain -------------------
FROM python:3.12-slim

# Pre-compiled bytecode trades a slightly larger image for faster cold-start imports -
# worth it here since Container Apps scale-to-zero means "cold start" isn't rare.
ENV UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src ./src
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000
CMD ["uvicorn", "docintel.api:app", "--host", "0.0.0.0", "--port", "8000"]
